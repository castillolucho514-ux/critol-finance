# Required: generate with `openssl rand -hex 32`
JWT_SECRET=
POSTGRES_USER=critol
POSTGRES_PASSWORD=
POSTGRES_DB=critol
DATABASE_URL=postgresql://critol:CHANGE_ME@localhost:5432/critol
PORT=4000
# Comma-separated origins: web frontend and Capacitor Android/iOS app.
CORS_ORIGIN=http://localhost:3000,https://your-app.example.com,https://localhost,capacitor://localhost
# Comma-separated emails granted ADMIN role at registration
ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COINBASE_API_BASE=https://api.coinbase.com
NEXT_PUBLIC_API_URL=http://localhost:4000
